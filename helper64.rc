// helper64.exe's version resource: who made it and what it is, as Windows shows it under Properties > Details.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     8,0,0,0
PRODUCTVERSION  8,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "JGdaCaesar"
            VALUE "FileDescription",  "Upscaling and Framegen helper: runs NVIDIA DLSS / AMD FSR for the Total War add-ons"
            VALUE "FileVersion",      "8.0.0.0"
            VALUE "InternalName",     "helper64"
            VALUE "LegalCopyright",   "JGdaCaesar. Source: github.com/JSa25/TotalWarUpscalingFramegen"
            VALUE "OriginalFilename", "helper64.exe"
            VALUE "ProductName",      "Upscaling and Framegen for Total War"
            VALUE "ProductVersion",   "8.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
